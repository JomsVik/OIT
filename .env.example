# Для первого запуска. Без пароля сервер с пустой БД не запускается.
BOOTSTRAP_LOGIN=director
BOOTSTRAP_PASSWORD=
# true при доступе через HTTPS; false для локального HTTP.
COOKIE_SECURE=false
# Нативный запуск (Docker задаёт адрес и путь самостоятельно).
BIND_ADDR=127.0.0.1:3000
DATABASE_PATH=data/oit.sqlite3
# Публикация порта Docker. Для локальной сети укажите IP интерфейса сервера.
LISTEN_IP=127.0.0.1
PORT=3000
